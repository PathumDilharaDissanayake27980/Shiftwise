{
  "name": "shiftwise",
  "private": true,
  "version": "1.4.0",
  "description": "Offline-first planner for shift workers: roster, time logging, activity planning, fatigue insights and a built-in rules assistant.",
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "check": "npm run typecheck && npm run lint && npm run test"
  },
  "dependencies": {
    "@fontsource/familjen-grotesk": "5.2.5",
    "@fontsource/ibm-plex-mono": "5.2.5",
    "@fontsource/ibm-plex-sans": "5.2.5",
    "dexie": "4.0.11",
    "dexie-react-hooks": "1.1.7",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "9.27.0",
    "@types/node": "22.15.21",
    "@types/react": "19.1.6",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.0",
    "@vitest/coverage-v8": "3.1.4",
    "eslint": "9.27.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "fake-indexeddb": "6.0.1",
    "globals": "16.2.0",
    "typescript": "5.8.3",
    "typescript-eslint": "8.32.1",
    "vite": "6.3.5",
    "vite-plugin-pwa": "1.0.0",
    "vitest": "3.1.4"
  }
}
